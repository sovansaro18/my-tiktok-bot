# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=8880372904:AAFu7hC79aM4VY6N2HZDHZGdkN6gCElO9-0

# Supabase PostgreSQL connection string
# NOTE: URL-encode special characters in the password (e.g. / → %2F, ? → %3F)
SUPABASE_URI=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Your Telegram User ID (for admin commands)
ADMIN_ID=123456789

# Telegram Channel ID for logging (can be negative, e.g., -1001234567890)
LOG_CHANNEL_ID=-1001234567890

# Channel ID to receive /report messages
REPORT_CHANNEL_ID=-1003569125986

# Cookies file path (optional) for age-restricted / login-required content.
# Mount the file into the container (e.g. /secrets/cookies.txt) and point to it,
# or place it in the project root and set COOKIES_FILE=cookies.txt.
COOKIES_FILE=cookies.txt

# Logging (optional)
LOG_LEVEL=INFO

# Optional: Port for health check server (default: 10000)
# PORT=10000
